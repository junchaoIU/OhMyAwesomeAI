---
import type { CollectionEntry } from 'astro:content';
import DomainBadge from './DomainBadge.astro';
import { QUESTION_STATUS_META } from '../lib/utils';
import { u } from '../lib/utils';

interface Props {
  entry: CollectionEntry<'questions'>;
  domainName: string;
  color: string;
}

const { entry, domainName, color } = Astro.props;
const { title, domain, status, whyMatters } = entry.data;
const statusMeta = QUESTION_STATUS_META[status];
---

<!-- 同 PaperCard：卡片本体不可为 <a>（内部 DomainBadge 是链接），
     采用 stretched-link 铺满点击层，徽章链接置于其上。 -->
<article class="panel group relative block p-5 transition hover:border-white/25 hover:bg-void-800/70">
  <a href={u(`questions/${entry.id}`)} class="absolute inset-0 rounded-2xl" aria-label={`${title}：查看研究问题`}></a>
  <div class="flex flex-wrap items-center gap-2">
    <h3 class="text-base font-semibold leading-snug text-star-100 transition group-hover:text-white">
      {title}
    </h3>
    <span class:list={['chip', statusMeta.cls]}>{statusMeta.label}</span>
  </div>
  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-star-300">{whyMatters}</p>
  <div class="relative z-10 mt-4">
    <DomainBadge slug={domain} name={domainName} color={color} />
  </div>
</article>
