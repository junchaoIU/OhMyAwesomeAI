---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  accent?: string;
}

const { eyebrow, title, description, accent = '#818cf8' } = Astro.props;
---

<div class="mb-10">
  {
    eyebrow && (
      <p class="mb-2 text-xs font-semibold tracking-[0.25em] text-star-500">{eyebrow}</p>
    )
  }
  <h1 class="font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
  {description && <p class="mt-3 max-w-3xl text-sm leading-relaxed text-star-300 sm:text-base">{description}</p>}
  <div class="domain-line mt-6 h-px w-full" style={`--c:${accent}`}></div>
</div>
