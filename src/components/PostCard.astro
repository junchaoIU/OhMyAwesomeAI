---
import type { CollectionEntry } from 'astro:content';
import { formatDate, u } from '../lib/utils';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { title, date, description } = entry.data;
---

<a href={u(`blog/${entry.id}`)} class="panel group block p-5 transition hover:border-white/25 hover:bg-void-800/70">
  <p class="text-xs text-star-500">{formatDate(date)}</p>
  <h3 class="mt-1.5 text-base font-semibold leading-snug text-star-100 transition group-hover:text-white">
    {title}
  </h3>
  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-star-300">{description}</p>
</a>
