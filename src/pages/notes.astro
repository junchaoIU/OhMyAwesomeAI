---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDate } from '../lib/utils';

const notes = await getCollection('notes');
const sorted = [...notes].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  sorted.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="日志速记" description="不追求完整的碎片笔记：新论文的第一印象、读论文时的旁注、随手想法。">
  <PageHeader
    eyebrow="TINKERING LOG"
    title="日志速记"
    description="速记是综述的原料场：不追求完整、允许出错，重要的是把当时的判断留下来，供日后回看修订。"
    accent="#94a3b8"
  />

  <div class="max-w-3xl space-y-5">
    {
      rendered.map(({ entry, Content }) => (
        <article id={entry.id} class="panel scroll-mt-24 p-5 sm:p-6">
          <div class="flex flex-wrap items-center gap-3">
            <time class="text-xs text-star-500">{formatDate(entry.data.date)}</time>
            {entry.data.title && (
              <h2 class="text-sm font-semibold text-star-100">{entry.data.title}</h2>
            )}
            {entry.data.tags.length > 0 && (
              <span class="text-xs text-star-600"># {entry.data.tags.join(' · # ')}</span>
            )}
          </div>
          <div class="prose prose-invert mt-3 max-w-none text-sm">
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>
