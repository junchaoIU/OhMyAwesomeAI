---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import Rating from '../../components/Rating.astro';
import Toc from '../../components/Toc.astro';
import { ROOT_COLORS, makeParentMap, rootOf } from '../../lib/domains';
import { tocItems, u } from '../../lib/utils';

export async function getStaticPaths() {
  const papers = await getCollection('papers');
  return papers.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const domains = await getCollection('domains');
const parentMap = makeParentMap(domains);
const domainName = domains.find((d) => d.id === entry.data.domain)?.data.name ?? entry.data.domain;
const domainColor = ROOT_COLORS[rootOf(entry.data.domain, parentMap)] ?? '#94a3b8';
const toc = tocItems(headings);
const showToc = toc.length >= 3;
---

<BaseLayout title={entry.data.title} description={entry.data.oneLiner}>
  <div
    class:list={[
      'mx-auto max-w-3xl',
      showToc && 'xl:max-w-5xl xl:grid xl:grid-cols-[minmax(0,48rem)_190px] xl:gap-10',
    ]}
  >
    <article class="min-w-0">
    <nav class="mb-4 flex items-center gap-1.5 text-xs text-star-500">
      <a href={u('papers')} class="transition hover:text-star-200">论文精读</a>
      <span>/</span>
      <span class="text-star-300">{entry.data.title}</span>
    </nav>

    <header>
      <div class="flex flex-wrap items-center gap-3">
        <Rating value={entry.data.rating} />
        <DomainBadge
          slug={entry.data.domain}
          name={domainName}
          color={domainColor}
          size="md"
        />
      </div>
      <h1 class="mt-3 font-serif text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-3 text-sm text-star-400">
        {entry.data.authors} · {entry.data.venue ? `${entry.data.venue} · ` : ''}{entry.data.year}
      </p>
      {
        entry.data.url && (
          <a
            href={entry.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs text-star-200 transition hover:border-white/30 hover:text-white"
          >
            阅读原文
            <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
              <path d="M6 1h5v5H9.5V3.5L5.25 7.75 4.25 6.75 8.5 2.5H6V1zM2 2h3v1.5H3.5V9H9V7.5h1.5V10.5H2V2z" />
            </svg>
          </a>
        )
      }
      <p class="mt-5 border-l-2 border-sky-400/50 pl-4 text-base leading-relaxed text-star-200">
        {entry.data.oneLiner}
      </p>
    </header>

    {
      entry.data.takeaways.length > 0 && (
        <section class="panel mt-8 p-5" style={`--c:${domainColor}`}>
          <h2 class="flex items-center gap-2 text-sm font-semibold text-white">
            <span class="domain-dot" /> 核心要点
          </h2>
          <ul class="mt-3 space-y-2">
            {entry.data.takeaways.map((t) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-star-300">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-star-400" />
                {t}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {showToc && <Toc variant="inline" headings={toc} color={domainColor} />}

    <div class="prose prose-invert mt-10 max-w-none">
      <Content />
    </div>

    <div class="mt-12 flex items-center justify-between border-t border-white/10 pt-6 text-sm">
      <a href={u('papers')} class="text-star-400 transition hover:text-white">← 返回论文列表</a>
      <a href={u(`map/${entry.data.domain}`)} class="text-star-400 transition hover:text-white">
        前往{domainName}领域 →
      </a>
    </div>
    </article>
    {showToc && <Toc variant="rail" headings={toc} color={domainColor} />}
  </div>
</BaseLayout>
