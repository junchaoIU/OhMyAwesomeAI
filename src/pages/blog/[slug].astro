---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import Toc from '../../components/Toc.astro';
import { ROOT_COLORS, makeParentMap, rootOf } from '../../lib/domains';
import { formatDate, tocItems, u } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const domains = await getCollection('domains');
const parentMap = makeParentMap(domains);
const domainName = entry.data.domain
  ? domains.find((d) => d.id === entry.data.domain)?.data.name
  : undefined;
const domainColor = entry.data.domain
  ? ROOT_COLORS[rootOf(entry.data.domain, parentMap)] ?? '#94a3b8'
  : '#94a3b8';
const toc = tocItems(headings);
const showToc = toc.length >= 3;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div
    class:list={[
      'mx-auto max-w-3xl',
      showToc && 'xl:max-w-5xl xl:grid xl:grid-cols-[minmax(0,48rem)_190px] xl:gap-10',
    ]}
  >
    <article class="min-w-0">
    <nav class="mb-4 flex items-center gap-1.5 text-xs text-star-500">
      <a href={u('blog')} class="transition hover:text-star-200">综述</a>
      <span>/</span>
      <span class="text-star-300">{entry.data.title}</span>
    </nav>

    <header>
      <h1 class="font-serif text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
        {entry.data.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-star-400">
        <time>{formatDate(entry.data.date)}</time>
        {domainName && entry.data.domain && (
          <DomainBadge slug={entry.data.domain} name={domainName} color={domainColor} size="md" />
        )}
        {
          entry.data.tags.length > 0 && (
            <span class="text-star-500"># {entry.data.tags.join(' · # ')}</span>
          )
        }
      </div>
      <p class="mt-5 border-l-2 border-indigo-400/50 pl-4 text-base leading-relaxed text-star-200">
        {entry.data.description}
      </p>
    </header>

    {showToc && <Toc variant="inline" headings={toc} color={domainColor} />}

    <div class="prose prose-invert mt-10 max-w-none">
      <Content />
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-sm">
      <a href={u('blog')} class="text-star-400 transition hover:text-white">← 返回综述列表</a>
    </div>
    </article>
    {showToc && <Toc variant="rail" headings={toc} color={domainColor} />}
  </div>
</BaseLayout>
