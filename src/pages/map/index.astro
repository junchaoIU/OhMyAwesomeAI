---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import DomainTree from '../../components/DomainTree.astro';
import PageHeader from '../../components/PageHeader.astro';
import { ROOT_COLORS, buildDomainTree, makeParentMap, rootOf, subtreeOf } from '../../lib/domains';
import { DOMAIN_STATUS_META, u } from '../../lib/utils';

const domains = await getCollection('domains');
const papers = await getCollection('papers');
const questions = await getCollection('questions');
const timeline = await getCollection('timeline');

const parentMap = makeParentMap(domains);
const tree = buildDomainTree(domains);
const colorOf = (slug: string) => ROOT_COLORS[rootOf(slug, parentMap)] ?? '#94a3b8';
---

<BaseLayout
  title="世界地图"
  description="AI 研究的世界地图：十大根领域与子领域的结构化导航，每个领域附概述、代表工作与演进脉络。"
>
  <PageHeader
    eyebrow="THE WORLD MAP"
    title="AI 世界地图"
    description="左侧领域树可折叠导航；右侧按根领域分区，每张卡片是一个可下钻的领域节点。颜色代表根领域，徽标代表领域生命周期。"
  />

  <!-- 图例 -->
  <div class="mb-8 flex flex-wrap items-center gap-2 text-xs text-star-400">
    <span class="mr-1 text-star-500">领域状态：</span>
    {
      Object.entries(DOMAIN_STATUS_META).map(([key, meta]) => (
        <span class:list={['chip', meta.cls]}>{meta.label}</span>
      ))
    }
  </div>

  <div class="grid gap-8 lg:grid-cols-[280px_1fr]">
    <!-- 左侧领域树 -->
    <aside class="panel top-20 h-fit p-4 lg:sticky">
      <p class="mb-3 px-2 text-xs font-semibold tracking-[0.2em] text-star-500">领域树</p>
      <DomainTree roots={tree} />
    </aside>

    <!-- 右侧领域分区 -->
    <div class="space-y-12">
      {
        tree.map((root) => {
          const subtree = subtreeOf(root.slug, domains);
          const rootPapers = papers.filter((p) => subtree.has(p.data.domain)).length;
          const rootEvents = timeline.filter((t) => subtree.has(t.data.domain)).length;
          const rootQuestions = questions.filter((q) => subtree.has(q.data.domain)).length;
          const meta = DOMAIN_STATUS_META[root.entry.data.status];
          return (
            <section>
              <a
                href={u(`map/${root.slug}`)}
                class="domain-card block rounded-2xl p-6 transition"
                style={`--c:${colorOf(root.slug)}`}
              >
                <div class="flex flex-wrap items-center gap-3">
                  <span class="domain-dot" />
                  <h2 class="domain-glow-text font-serif text-2xl font-bold">{root.entry.data.name}</h2>
                  <span class="text-xs uppercase tracking-[0.15em] text-star-500">{root.entry.data.en}</span>
                  <span class:list={['chip', meta.cls]}>{meta.label}</span>
                </div>
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-star-300">{root.entry.data.summary}</p>
                <p class="mt-4 text-xs text-star-500">
                  {root.children.length} 个子领域 · {rootPapers} 篇精读 · {rootEvents} 个时间线事件 · {rootQuestions} 个研究问题
                  <span class="ml-2 text-star-300 transition group-hover:text-white">进入领域 →</span>
                </p>
              </a>

              {root.children.length > 0 && (
                <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                  {root.children.map((child) => {
                    const childMeta = DOMAIN_STATUS_META[child.entry.data.status];
                    return (
                      <a
                        href={u(`map/${child.slug}`)}
                        class="panel group block p-4 transition hover:border-white/25 hover:bg-void-800/70"
                        style={`--c:${colorOf(child.slug)}`}
                      >
                        <div class="flex items-center justify-between gap-2">
                          <span class="flex items-center gap-2 text-sm font-semibold text-star-100 transition group-hover:text-white">
                            <span class="domain-dot" style="width:0.45rem;height:0.45rem" />
                            {child.entry.data.name}
                          </span>
                          <span class:list={['chip shrink-0', childMeta.cls]}>{childMeta.label}</span>
                        </div>
                        <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-star-400">{child.entry.data.summary}</p>
                      </a>
                    );
                  })}
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
