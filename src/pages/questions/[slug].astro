---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import { ROOT_COLORS, makeParentMap, rootOf } from '../../lib/domains';
import { formatDate, u } from '../../lib/utils';

export async function getStaticPaths() {
  const questions = await getCollection('questions');
  return questions.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const domains = await getCollection('domains');
const parentMap = makeParentMap(domains);
const domainName = domains.find((d) => d.id === entry.data.domain)?.data.name ?? entry.data.domain;
const domainColor = ROOT_COLORS[rootOf(entry.data.domain, parentMap)] ?? '#94a3b8';
const statusMap = {
  open: '悬而未决',
  progressing: '稳步推进',
  contested: '存在争议',
  'partially-solved': '部分解决',
} as const;
---

<BaseLayout title={entry.data.title} description={entry.data.whyMatters}>
  <article class="mx-auto max-w-3xl">
    <nav class="mb-4 flex items-center gap-1.5 text-xs text-star-500">
      <a href={u('questions')} class="transition hover:text-star-200">研究问题</a>
      <span>/</span>
      <span class="text-star-300">{entry.data.title}</span>
    </nav>

    <header>
      <div class="flex flex-wrap items-center gap-3">
        <span class="chip bg-amber-500/10 text-amber-300 ring-amber-400/30">
          {statusMap[entry.data.status]}
        </span>
        <DomainBadge slug={entry.data.domain} name={domainName} color={domainColor} size="md" />
      </div>
      <h1 class="mt-3 font-serif text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
        {entry.data.title}
      </h1>
    </header>

    <section class="panel mt-8 p-5" style={`--c:${domainColor}`}>
      <h2 class="flex items-center gap-2 text-sm font-semibold text-white">
        <span class="domain-dot" /> 为什么重要
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-star-300">{entry.data.whyMatters}</p>
    </section>

    {
      entry.data.keyWorks.length > 0 && (
        <section class="mt-6">
          <h2 class="mb-3 font-serif text-lg font-bold text-white">关键工作</h2>
          <ul class="panel divide-y divide-white/5">
            {entry.data.keyWorks.map((w) => (
              <li class="flex items-start gap-3 px-5 py-3 text-sm text-star-300">
                <span class="domain-dot mt-1.5" style="width:0.35rem;height:0.35rem" />
                {w}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose prose-invert mt-10 max-w-none">
      <Content />
    </div>

    <div class="mt-12 flex items-center justify-between border-t border-white/10 pt-6 text-sm">
      <a href={u('questions')} class="text-star-400 transition hover:text-white">← 返回问题列表</a>
      <a href={u(`map/${entry.data.domain}`)} class="text-star-400 transition hover:text-white">
        前往{domainName}领域 →
      </a>
    </div>
  </article>
</BaseLayout>
